{
  "private": true,
  "name": "meshron-desktop",
  "productName": "Meshron",
  "version": "1.6.3",
  "description": "Private messages, device to device",
  "author": "xalvxnLab <baxxkid@gmail.com>",
  "homepage": "https://github.com/xalvxn-dev/meshron",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win nsis --x64",
    "dist-mod": "node prepare-mod.js && electron-builder --config mod-builder.json --win nsis --x64",
    "start-asst": "node prepare-asst.js && electron asst-main.js",
    "dist-asst": "node prepare-asst.js && electron-builder --config asst-builder.json --win nsis --x64"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "^6.9.2",
    "b4a": "^1.9.0",
    "blind-relay": "^1.6.1",
    "bonjour-service": "^1.3.0",
    "compact-encoding": "^3.6.0",
    "corestore": "^7.16.1",
    "hyperblobs": "^2.13.0",
    "hypercore-crypto": "^3.7.0",
    "hyperdht": "^6.36.0",
    "hyperswarm": "^4.17.2",
    "protomux": "^3.13.0",
    "sodium-universal": "^5.0.1",
    "streamx": "^2.28.1"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "kokoro-js": "1.2.1",
    "kokoro-ort": "npm:@huggingface/transformers@3.5.1"
  },
  "build": {
    "appId": "com.xalvxnlab.meshron.desktop",
    "productName": "Meshron",
    "copyright": "Â© 2026 xalvxnLab",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "bundle/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/**/prebuilds/{android,darwin,ios,linux}*/**",
      "!node_modules/**/prebuilds/win32-{arm64,ia32}/**",
      "!node_modules/**/{test,tests,example,examples,docs,.github,benchmark,bench}/**",
      "!node_modules/**/*.{md,markdown,map,ts,tsbuildinfo}",
      "!node_modules/**/{CHANGELOG,HISTORY,AUTHORS}*"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.bare",
      "**/prebuilds/**"
    ],
    "protocols": [
      {
        "name": "Meshron link",
        "schemes": [
          "meshron"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Meshron-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Meshron",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  }
}
