{
  "private": true,
  "name": "meshron-desktop",
  "productName": "Meshron",
  "version": "1.4.0",
  "description": "Private messages, device to device",
  "author": "xalvxnLab <baxxkid@gmail.com>",
  "homepage": "https://github.com/xalvxn-dev/meshron",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "^6.9.2",
    "b4a": "^1.9.0",
    "blind-relay": "^1.6.1",
    "bonjour-service": "^1.3.0",
    "compact-encoding": "^3.6.0",
    "corestore": "^7.16.1",
    "hyperblobs": "^2.13.0",
    "hypercore-crypto": "^3.7.0",
    "hyperdht": "^6.36.0",
    "hyperswarm": "^4.17.2",
    "protomux": "^3.13.0",
    "sodium-universal": "^5.0.1",
    "streamx": "^2.28.1"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.xalvxnlab.meshron.desktop",
    "productName": "Meshron",
    "copyright": "© 2026 xalvxnLab",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "bundle/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.bare",
      "**/prebuilds/**"
    ],
    "protocols": [
      {
        "name": "Meshron link",
        "schemes": [
          "meshron"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Meshron-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Meshron",
      "deleteAppDataOnUninstall": false
    }
  }
}
