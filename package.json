{
  "private": true,
  "name": "meshron-worklet",
  "description": "Hyperswarm worklet for the Meshron Android client (runs in Bare Kit)",
  "scripts": {
    "pack": "bare-pack --preset android --linked --out app/src/main/assets/app.bundle app/src/main/js/app.js",
    "link": "bare-link --preset android --needs libbare-kit.so --out app/src/main/addons"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "^6.9.2",
    "b4a": "^1.9.0",
    "compact-encoding": "^3.6.0",
    "corestore": "^7.16.1",
    "hyperblobs": "^2.13.0",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.2",
    "protomux": "^3.13.0",
    "sodium-universal": "^5.0.1",
    "streamx": "^2.28.1"
  },
  "devDependencies": {
    "bare-link": "^4.2.0",
    "bare-pack": "^3.0.2"
  }
}
