<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: the reactor (tap to talk), and three one-tap requests. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="14dp">
    <ImageView android:id="@+id/w_orb" android:layout_width="72dp" android:layout_height="72dp"
        android:src="@drawable/widget_orb" android:contentDescription="Talk to Meshron Assistant" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:id="@+id/w_talk" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MESHRON · TAP TO TALK" android:textColor="#22D3C5" android:textSize="11sp"
            android:fontFamily="monospace" android:letterSpacing="0.15" android:textStyle="bold" android:paddingBottom="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/widget_chip" android:paddingHorizontal="10dp" android:paddingVertical="6dp"
                android:text="Plan my day" android:textColor="#E6F7FF" android:textSize="12sp" />
            <TextView android:id="@+id/w_inbox" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:background="@drawable/widget_chip" android:paddingHorizontal="10dp" android:paddingVertical="6dp"
                android:text="Inbox" android:textColor="#E6F7FF" android:textSize="12sp" />
            <TextView android:id="@+id/w_torch" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:background="@drawable/widget_chip" android:paddingHorizontal="10dp" android:paddingVertical="6dp"
                android:text="Torch" android:textColor="#E6F7FF" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
